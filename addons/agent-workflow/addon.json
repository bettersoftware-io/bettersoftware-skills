{
  "name": "agent-workflow",
  "summary": "How an agent ships work: a hook that keeps each push and pull request step in a call of its own, permission rules for the routine ones, a worktree script, a weekly tag and a changelog.",
  "recommended": false,
  "packageJson": {
    ".": {
      "scripts": {
        "worktree": "node tools/agent-workflow/new-worktree.mts",
        "changelog": "node tools/agent-workflow/changelog.mts",
        "agent-workflow:check": "node tools/agent-workflow/check.mts"
      }
    }
  },
  "gates": {
    "fast": [],
    "full": []
  },
  "startingFiles": [
    "CHANGELOG.md"
  ],
  "hostSettings": {
    ".claude/settings.json": {
      "permissions": {
        "allow": [
          "Bash(git push -u origin worktree-*)",
          "Bash(git push origin worktree-*)",
          "Bash(gh pr create *)",
          "Bash(gh pr merge *)"
        ],
        "ask": [
          "Bash(git push *--force*)",
          "Bash(git push -f*)",
          "Bash(git push * -f*)",
          "Bash(git push * +*)",
          "Bash(git push *:*)"
        ]
      },
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "node \"$CLAUDE_PROJECT_DIR/tools/agent-workflow/hooks/split-outward-commands.mts\"",
                "timeout": 5
              }
            ]
          }
        ]
      }
    },
    ".codex/hooks.json": {
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "node tools/agent-workflow/hooks/split-outward-commands.mts",
                "statusMessage": "Checking how the command is joined",
                "timeout": 5
              }
            ]
          }
        ]
      }
    }
  },
  "verify": "pnpm agent-workflow:check"
}

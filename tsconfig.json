{
  // Typecheck-only. Every file here is run by plain `node`, which strips the
  // types and never checks them, so `pnpm typecheck` is the only place they
  // are checked. `erasableSyntaxOnly` rejects the syntax type-stripping cannot
  // run (an enum, a namespace, a parameter property) here, not at runtime.
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["kit/**/*.mts", "scripts/**/*.mts", "vitest.config.mts"],
  "exclude": ["kit/gates/fixtures", "kit/architecture.config.example.mts", "node_modules"]
}
